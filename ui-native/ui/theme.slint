// ===========================================================================
//  STARTORCH ACADEMY x AEMEATH — UNIVERSAL ATOMIC DESIGN SYSTEM
//  Native (Slint) port of src/lib/startorch-ui.css
//  Token-for-token: every value below maps 1:1 to a --st-* CSS variable.
// ===========================================================================

// Static font instances for razor-sharp rendering in Slint's software renderer.
// Variable fonts lack hinting and cause thin/broken/fuzzy glyph outlines at standard resolutions.
import "../assets/fonts/SpaceGrotesk-Bold.ttf";
import "../assets/fonts/SpaceGrotesk-UI.ttf";
import "../assets/fonts/PlusJakartaSans-SemiBold.ttf";
import "../assets/fonts/PlusJakartaSans-Bold.ttf";
import "../assets/fonts/JetBrainsMono-Bold.ttf";
import "../assets/fonts/AemeathMono-Regular.ttf";
import "../assets/fonts/AemeathMono-Bold.ttf";
// Static Regular/Bold instances of Plus Jakarta Sans under a private family
// name. Without them regular body text resolved to the per-user *variable*
// font, which the software renderer rasterises without hinting (soft glyphs).
import "../assets/fonts/AemeathSans-Regular.ttf";
import "../assets/fonts/AemeathSans-Bold.ttf";

export global Tokens {
    // --- 2.1 Base & Surface Tokens (Glass & Void) ---
    in-out property <color> bg-void: #070A12;
    in-out property <color> surface-base: #0E1422;
    in-out property <color> surface-glass: #131B2EBD;          // rgba(19,27,46,0.74)
    in-out property <color> surface-glass-heavy: #0E1422E0;    // rgba(14,20,34,0.88)
    in-out property <color> surface-hover: #1E2A46E0;          // rgba(30,42,70,0.88)
    in-out property <color> surface-active: #28385CF2;         // rgba(40,56,92,0.95)

    // --- 2.2 Signature Accent Tokens (Aemeath & Startorch) ---
    in-out property <color> aemeath-pink: #FF8FB1;
    in-out property <color> aemeath-soft: #FFC4D6;
    in-out property <color> aemeath-deep: #FF6392;
    in-out property <color> halo-cyan: #3CE8FF;
    in-out property <color> halo-dim: #3CE8FF59;               // rgba(60,232,255,0.35)
    in-out property <color> polestar-gold: #FFD166;
    in-out property <color> overdrive-red: #FF477E;
    in-out property <color> sync-emerald: #2CE59B;

    // --- Text Hierarchy ---
    in-out property <color> text-main: #F4F7FB;
    in-out property <color> text-muted: #CBD5E1;
    in-out property <color> text-dim: #CBD5E1A0;
    in-out property <color> text-glow: #FFFFFF;

    // --- Borders & Dividers ---
    in-out property <color> border-subtle: #3CE8FF2E;          // rgba(60,232,255,0.18)
    in-out property <color> border-pink: #FF8FB18C;            // rgba(255,143,177,0.55)
    in-out property <color> border-cyan: #3CE8FF73;            // rgba(60,232,255,0.45)
    in-out property <color> border-gold: #FFD16673;            // rgba(255,209,102,0.45)

    // --- 4. Typography Tokens ---
    // The three Google families are bundled in assets/fonts/*.ttf and installed
    // per-user by scripts/install-fonts.ps1. Slint falls back to the system
    // font when a family is missing, so the UI still renders without them.
    in-out property <string> font-display: "Space Grotesk";
    // Weight-600 display text (inactive nav/mode labels). Slint's software
    // renderer always picks one face per family, so 600 has its own family.
    in-out property <string> font-display-ui: "Space Grotesk UI";
    in-out property <string> font-sans: "Aemeath Sans";
    in-out property <string> font-sans-semibold: "Plus Jakarta Sans SemiBold";
    in-out property <string> font-sans-bold: "Plus Jakarta Sans Bold";
    in-out property <string> font-mono: "Aemeath Mono";
    in-out property <string> font-mono-regular: "Aemeath Mono";
    in-out property <string> font-mono-bold: "Aemeath Mono";

    // --- Gradients (CSS linear-gradient -> Slint @linear-gradient) ---
    in-out property <brush> grad-aemeath: @linear-gradient(135deg, #FF8FB1, #FF6392);
    in-out property <brush> grad-starlume: @linear-gradient(90deg, #3CE8FF, #FF8FB1 55%, #FFD166);
    in-out property <brush> grad-holo: @linear-gradient(180deg, #3CE8FF1F, #FF8FB10A);
    in-out property <brush> grad-dark: @linear-gradient(180deg, #0E1422F2, #070A12FA);
    in-out property <brush> grad-topbar: @linear-gradient(90deg, #070A12, #0E1422 50%, #070A12);
    in-out property <brush> grad-sidebar: @linear-gradient(180deg, #0E1422FA, #070A12FA);
    in-out property <brush> grad-aemeath-card: @linear-gradient(135deg, #131B2ED9, #0E1422F2);
    in-out property <brush> grad-avatar: @radial-gradient(circle, #3CE8FF24, #0E1422F2 75%);

    // --- Geometry (from the webview CSS) ---
    in-out property <length> topbar-height: 52px;
    in-out property <length> sidebar-width: 280px;
    in-out property <length> radius-card: 12px;
    in-out property <length> radius-row: 8px;
    in-out property <length> radius-pill: 999px;

    // --- Control Panel Typographic Scale (14px minimum floor) ---
    in-out property <length> panel-font-min: 14px;
    in-out property <length> panel-font-md: 15px;
    in-out property <length> panel-font-card: 16px;
    in-out property <length> panel-font-title: 21px;
    in-out property <length> panel-font-metric: 26px;
}

// ---------------------------------------------------------------------------
//  Icons — runtime SVG registry.
//  The 52 icons from src/lib/Icon.svelte are kept as raw SVG markup in
//  src/icons.rs. The callback substitutes `currentColor` with the requested
//  tint, rasterises via resvg (Slint's built-in SVG support) and caches the
//  result so repeated bindings are cheap.
// ---------------------------------------------------------------------------
export global Icons {
    pure callback render(name: string, tint: color) -> image;
    pure callback render-sized(name: string, tint: color, size-px: int) -> image;
}
