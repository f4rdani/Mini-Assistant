import { Tokens, Icons } from "theme.slint";
import { Icon, AemeathAvatar, Equalizer, HudAction, OrbitalSwitch } from "components.slint";
import { ScrollView } from "std-widgets.slint";
import { AttachmentItem, HudMessage, SearchSourceItem, ChatLayout } from "model.slint";

// Read-only multiline TextInput for directly selectable response text (no editing caret).
component SelectableText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    text-cursor-width: 0px;
    selection-background-color: #3CE8FF55;
    selection-foreground-color: #FFFFFF;
}

// ===========================================================================
//  MODEL 2B — FLOATING COMPANION OVERLAY HUD
//  1:1 port of the "overlay_hud" branch of src/routes/+page.svelte
//
//  Reference: live Svelte app rendered in a 380x620 viewport and measured
//  through CDP (see %TEMP%/opencode/mini-ref/ref_hud_380.png). Numbers below
//  are the real getBoundingClientRect() values, not estimates.
//
//    glass         1.5px #3CE8FF66 r16, transparent fill, DWM acrylic blur
//    top strip     y0 h44  bg #070A12  bottom border 1.5px rgba(60,232,255,.3)
//    pill          x13 y12 167x22 r11  label 11px/700 display white
//    actions       x239 y9  4x28 gap6 r6 (pin gold when pinned)
//    chat          y45.5 h484  pad12 gap12
//    intro         pad 32 16 20, avatar md 64 (halo 115% dashed), title 13/700
//    bottom bar    y528.5 h90  transparent padding, preview/capsule above blur
//    capsule       x11.5 y568.5 289x40 r20 (auto-grows up to 289x97), rim gradient
//    action col    x308.5 y532.5 61x76: camera 28, send 42 with 6 gap
// ===========================================================================

export component HudWindow inherits Window {
    title: "Mini Assistant HUD";
    icon: @image-url("../assets/app-icon.png");
    preferred-width: 380px;
    preferred-height: 620px;
    min-width: 320px;
    min-height: 420px;
    max-width: 1200px;
    max-height: 1400px;
    resize-border-width: 8px;
    background: transparent;
    no-frame: true;
    always-on-top: true;
    default-font-family: Tokens.font-sans;
    default-font-size: 13px;

    // --- state ---
    in property <bool> pinned: true;
    in property <bool> pulldown-open: false;
    in property <bool> busy: false;
    // Typing indicator: which of the three dots is lit (0..2).
    in-out property <int> dot-phase: 0;
    in property <string> current-topic: "[Game] Game Window";
    in property <string> selected-model: "AUTO";
    // Off by default: sending a screenshot with every message is a privacy
    // and token-cost decision the user should make explicitly.
    in property <bool> auto-capture: false;
    in property <bool> capture-app: false;
    in property <bool> target-window-only: true;
    in property <bool> temp-chat: false;
    // Enter sends the message (default). When off, Enter only adds a new line
    // and the send button is the only way to submit.
    in property <bool> enter-sends: true;
    // When on, sending hides the HUD and the answer streams into the mascot
    // bubble (same surface as Translate This Screen).
    in property <bool> send-closes: false;
    // Chat typography (Control Panel > Pengaturan).
    in property <float> chat-font-px: 14;
    in property <string> chat-font-family: "Segoe UI";
    in-out property <string> input-text: "";
    // True while the composer has focus: the clipboard watcher only turns a
    // pasted screenshot into an attachment then, so copying images elsewhere
    // never hijacks the HUD.
    in-out property <bool> input-focused: input.has-focus;
    in property <string> detected-window: "";
    in property <string> detected-category: "";
    in property <image> avatar;
    in property <image> avatar-hi;
    in property <image> avatar-hud;
    in property <[HudMessage]> messages;
    in property <[string]> topics;
    in property <[string]> models;
    in property <string> status-text: "";
    in property <bool> status-visible: false;
    // Only promises a screenshot when auto-capture is actually on.
    in property <string> placeholder: root.auto-capture
        ? "Tulis pesan (layar otomatis dijepret)..."
        : "Tanya apa saja...";
    // Multiple pending attachments (screenshots captured with camera button,
    // files attached via +, or clipboard Ctrl+V pastes).
    in property <[AttachmentItem]> attachments: [];
    in property <bool> has-attachment: false;
    in property <bool> attachment-is-image: false;
    in property <image> attachment-thumb;
    in property <string> attachment-ext: "";
    // In-HUD image & SVG zoom lightbox
    in-out property <bool> lightbox-open: false;
    in-out property <image> lightbox-image;
    in-out property <string> lightbox-caption: "";
    in-out property <string> lightbox-url: "";
    in-out property <string> lightbox-raw: "";
    // Web search results modal ("Hasil pencarian")
    in-out property <bool> search-modal-open: false;
    in property <[SearchSourceItem]> search-modal-sources: [];
    in property <int> search-modal-count: 0;
    out property <length> chat-scroll-y: -chat-vp.content-y;
    out property <length> chat-scroll-max: max(0px, chat-vp.content-height - chat-vp.height);

    // --- callbacks ---
    callback pin-toggled;
    callback collapse-requested;
    callback open-control-panel;
    callback drag-request;
    callback send-request(text: string);
    callback toggle-pulldown;
    callback toggle-thought(index: int);
    callback toggle-detail(index: int);
    callback toggle-search-sources(index: int);
    callback open-search-modal(index: int);
    callback open-url(url: string);
    callback open-svg-external(svg: string);
    callback copy-message(index: int);
    callback open-partial-copy(index: int);
    callback prepare-partial-selection;
    callback commit-partial-selection(index: int);
    callback copy-code(code: string);
    callback retry-request(index: int);
    callback model-selected(model: string);
    callback topic-selected(topic: string);
    callback new-session;
    callback auto-capture-toggled;
    callback capture-app-toggled;
    callback target-window-toggled;
    callback temp-chat-toggled;
    callback capture-screen;
    callback attach-requested;
    callback remove-attachment;
    callback remove-attachment-at(index: int);
    callback open-attachment(index: int);
    callback open-pending-attachment;
    callback open-pending-attachment-at(index: int);
    callback open-message-attachment(msg-index: int, attach-index: int);
    callback paste-clipboard;

    public function scroll-to-bottom() {
        chat-vp.content-y = min(0px, chat-vp.height - max(chat-vp.content-height, chat-layout.preferred-height));
    }

    public function scroll-to-top() {
        chat-vp.content-y = 0px;
    }

    property <length> strip-h: 44px;
    // Composer growth: keep one line at 44px, grow with wrapped text, then
    // scroll once the viewport reaches 80px (capsule max 101px).
    property <length> input-content-h: max(19px, input.preferred-height);
    property <length> input-max-extra: 57px;
    property <length> input-extra: min(max(0px, input-content-h - 19px), input-max-extra);
    property <length> capsule-h: 44px + input-extra;
    property <length> capsule-y: root.height - 54px - input-extra;
    // With an attachment the 60px card hugs the top of the capsule (6px gap).
    // Only 27px of the web strip's height is below the old chat edge, so that
    // is all the chat viewport needs to give up; the card sits immediately
    // above the composer instead of leaving a 40px hole.
    property <length> attachment-space: (root.attachments.length > 0 || root.has-attachment) ? 27px : 0px;

    // =====================================================================
    //  GLASS SHELL  (.companion-hud-window.st-hud-glass)
    //  Light translucent glass backing with crisp 1px cyan rim and reduced
    //  backdrop opacity so the HUD feels airy and clean.
    // =====================================================================
    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: #070A1242;
        border-radius: 16px;
        border-width: 1px;
        border-color: #3CE8FF4D;
    }
    Image {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        opacity: 0.38;
        source: @image-url("../assets/hud/glass_glow.png");
    }

    // =====================================================================
    //  TOP STRIP  (.hud-top-strip)
    // =====================================================================
    Image {
        x: 0; y: 0;
        width: parent.width;
        height: 70px;
        opacity: 0.55;
        source: @image-url("../assets/hud/strip_shadow.png");
    }
    Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: root.strip-h;
        background: #070A128C;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }
    // border-bottom: 1px solid rgba(60,232,255,.3)
    Rectangle {
        x: 1px; y: root.strip-h;
        width: parent.width - 2px;
        height: 1px;
        background: #3CE8FF4D;
    }

    // Full-width drag strip. Declared before the pill and header buttons so
    // those controls still win the hit test, while every empty part of the
    // top bar can move the HUD. pointer-event (not clicked) is required:
    // begin_window_drag polls the left mouse button until release, so it must
    // start on press instead of after the button is already up.
    TouchArea {
        x: 0; y: 0;
        width: parent.width; height: root.strip-h;
        mouse-cursor: grab;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.drag-request();
            }
        }
    }

    // --- session pill (.hud-session-pill-btn) ---
    // Rectangular-rounded active-window pill with a strict max width so generous
    // breathing room always remains before the right-hand action buttons.
    topic-pill := Rectangle {
        x: 12px; y: 9px;
        width: min(210px, max(116px, parent.width - 170px));
        height: 26px;
        background: topic-touch.has-hover ? #161F33E6 : #0E1422CC;
        border-width: 1px;
        border-color: root.pulldown-open ? Tokens.halo-cyan : #3CE8FF4D;
        border-radius: 7px;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 8px;
            spacing: 6px;

            Text {
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
                text: root.current-topic;
                color: #FFFFFF;
                font-family: Tokens.font-display;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.3px;
            }

            Icon {
                y: (parent.height - 13px) / 2;
                size: 13px;
                name: root.pulldown-open ? "chevron-up" : "chevron-down";
                tint: Tokens.halo-cyan;
            }
        }

        topic-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle-pulldown(); }
        }
    }

    // --- header actions (.hud-header-actions, 3 x 28px, gap 6) ---
    // CSS pinned box-shadow: 0 0 10px rgb(255,209,102) — baked glow behind
    // the button (28px hole at local 14,8.5).
    if root.pinned : Image {
        x: parent.width - 121px; y: 0;
        width: 56px; height: 56px;
        source: @image-url("../assets/hud/pin_glow.png");
    }
    for ai in [ 0, 1, 2 ] : Rectangle {
        x: parent.width - 107px + ai * 34px;
        y: 8.5px;
        width: 28px; height: 28px;
        background: ai == 0 && root.pinned ? #FFD16640 : #FFFFFF14;
        border-width: 1px;
        border-color: ai == 0 && root.pinned ? Tokens.polestar-gold : #3CE8FF59;
        border-radius: 6px;

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (ai == 0) { root.pin-toggled(); }
                if (ai == 1) { root.collapse-requested(); }
                if (ai == 2) { root.open-control-panel(); }
            }
        }

        states [
            hovered when touch.has-hover && ai != 0 : {
                background: #FFFFFF24;
                border-color: Tokens.polestar-gold;
            }
        ]

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: ai == 2 ? 14px : 13px;
            name: ai == 0 ? (root.pinned ? "pin-filled" : "pin")
                : ai == 1 ? "minus"
                : "settings";
            tint: ai == 0 && root.pinned ? Tokens.polestar-gold : #e2e8f0;
        }
    }

    // =====================================================================
    //  CHAT VIEWPORT  (.hud-chat-viewport)  Full-height scroll (floating bar on top)
    // =====================================================================
    chat-vp := Flickable {
        x: 0; y: 45px;
        width: parent.width;
        height: parent.height - 45px;
        interactive: true;
        mouse-drag-pan-enabled: false;
        content-width: parent.width;
        content-height: chat-layout.preferred-height;

        chat-layout := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 12px;
            padding-bottom: 110px + root.input-extra + ((root.attachments.length > 0 || root.has-attachment) ? 72px : 0px);
            spacing: 14px;
            alignment: start;

            // ---- empty state: .hud-chat-intro-clean -------------------------
            if root.messages.length == 0 && !root.busy : Rectangle {
                height: 177px;
                width: parent.width - 24px;

                // intro avatar: 64px sprite inside a 68px line box, halo 115%
                AemeathAvatar {
                    x: (parent.width - 64px) / 2;
                    y: 32px;
                    size: 64px;
                    box-height: 68px;
                    halo: true;
                    sprite: root.avatar;
                }
                // Title baked at 1x from the browser: Space Grotesk 13/700 with its
                // CSS text-shadow: 0 0 12px rgba(255,143,177,.4). Abs (70,152).
                Image {
                    x: (parent.width - 242px) / 2; y: 95px;
                    width: 242px; height: 48px;
                    source: @image-url("../assets/hud/title.png");
                }
            }

            // ---- messages: flow naturally inside VerticalLayout ----------
            for m[idx] in root.messages : VerticalLayout {
                padding: 0;
                spacing: 0;

                // ---- USER BUBBLE ----
                if m.role == "user" : HorizontalLayout {
                    alignment: end;
                    user-bubble := Rectangle {
                        width: min(parent.width - 20px, user-flow.preferred-width + 24px);
                        height: user-flow.preferred-height;
                        background: #12243E99;
                        border-width: 1px;
                        border-color: #3CE8FF59;
                        border-radius: 14px;
                        border-top-left-radius: 14px;
                        border-top-right-radius: 4px;

                        user-flow := VerticalLayout {
                            padding: 10px;
                            spacing: 6px;
                            alignment: start;

                            // multi-attachment grid in user bubble
                            if m.attachments.length > 0 : Rectangle {
                                property <int> cols: m.attachments.length > 2 ? 3 : m.attachments.length;
                                property <int> rows: m.attachments.length > 6 ? 3 : (m.attachments.length > 3 ? 2 : 1);
                                width: self.cols * 80px - 6px;
                                height: self.rows * 66px - 6px;
                                background: transparent;

                                for att[a-idx] in m.attachments : Rectangle {
                                    x: mod(a-idx, 3) * 80px;
                                    y: floor(a-idx / 3) * 66px;
                                    width: 74px; height: 60px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: #00000040;
                                    border-width: 1px;
                                    border-color: #FFFFFF28;

                                    touch-matt := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-message-attachment(idx, a-idx); }
                                    }
                                    if att.is-image : Image {
                                        width: parent.width; height: parent.height;
                                        image-fit: cover;
                                        source: att.thumb;
                                    }
                                    if !att.is-image : Rectangle {
                                        width: parent.width; height: parent.height;
                                        background: transparent;
                                        Icon {
                                            x: (parent.width - 20px) / 2; y: 12px;
                                            size: 20px; name: "book"; tint: #CFE6FF;
                                        }
                                        Text {
                                            x: 0; y: 36px;
                                            width: parent.width; height: 16px;
                                            text: att.ext; color: #CFE6FF;
                                            font-family: Tokens.font-mono; font-size: 9px; font-weight: 700;
                                            horizontal-alignment: center;
                                        }
                                    }
                                    if touch-matt.has-hover : Rectangle {
                                        width: parent.width; height: parent.height;
                                        background: #00000060;
                                        Icon {
                                            x: (parent.width - 18px) / 2; y: (parent.height - 18px) / 2;
                                            size: 18px; name: "zoom"; tint: #FFFFFF;
                                        }
                                    }
                                }
                            }

                            // fallback single attachment (historical messages loaded without model list)
                            if m.attachments.length == 0 && m.attach-name != "" : Rectangle {
                                width: 76px;
                                height: 60px;
                                border-radius: 8px;
                                clip: true;
                                background: #00000040;
                                border-width: 1px;
                                border-color: #FFFFFF1F;

                                touch-attach := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-attachment(idx); }
                                }

                                if m.attach-image : Image {
                                    width: parent.width; height: parent.height;
                                    source: m.attach-thumb;
                                }
                                if !m.attach-image : Rectangle {
                                    width: parent.width; height: parent.height;
                                    background: transparent;
                                    Icon {
                                        x: (parent.width - 20px) / 2; y: 12px;
                                        size: 20px; name: "book"; tint: #CFE6FF;
                                    }
                                    Text {
                                        x: 0; y: 36px;
                                        width: parent.width; height: 16px;
                                        text: m.attach-name; color: #CFE6FF;
                                        font-family: Tokens.font-mono; font-size: 9px; font-weight: 700;
                                        horizontal-alignment: center;
                                    }
                                }

                                if touch-attach.has-hover : Rectangle {
                                    width: parent.width; height: parent.height;
                                    background: #00000060;
                                    Icon {
                                        x: (parent.width - 18px) / 2; y: (parent.height - 18px) / 2;
                                        size: 18px; name: "zoom"; tint: #FFFFFF;
                                    }
                                }
                            }

                            // user text (directly selectable when plain text)
                            if m.user-selectable : SelectableText {
                                text: m.body;
                                color: #F1F5F9;
                                font-family: root.chat-font-family;
                                font-size: root.chat-font-px * 1px;
                            }
                            if !m.user-selectable : StyledText {
                                text: m.styled;
                                default-color: #F1F5F9;
                                default-font-family: root.chat-font-family;
                                default-font-size: root.chat-font-px * 1px;
                                link-color: #5CE1FF;
                                link-clicked(u) => { root.open-url(u); }
                            }
                        }
                    }
                }

                // ---- ASSISTANT BUBBLE ----
                if m.role == "assistant" : asst-bubble := Rectangle {
                    width: parent.width;
                    height: asst-flow.preferred-height;
                    background: #0A112099;
                    border-width: 1px;
                    border-color: #3CE8FF38;
                    border-radius: 14px;
                    border-top-left-radius: 4px;
                    border-top-right-radius: 14px;

                    asst-flow := VerticalLayout {
                        padding: 12px;
                        spacing: 9px;
                        alignment: start;

                        // Header: Aemeath
                        HorizontalLayout {
                            height: 28px;
                            spacing: 9px;
                            alignment: start;
                            Rectangle {
                                width: 28px; height: 28px;
                                border-radius: 14px; clip: true;
                                background: #FF8FB122; border-width: 1.5px; border-color: #FF8FB160;
                                AemeathAvatar {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    size: 28px; hi-res: true;
                                    sprite-hi: root.avatar-hud; sprite: root.avatar;
                                }
                            }
                            Text {
                                vertical-alignment: center;
                                text: "Aemeath"; color: #FF8FB1;
                                font-family: Tokens.font-display; font-size: 13px; font-weight: 700;
                            }
                            Rectangle {
                                y: (parent.height - 17px) / 2;
                                height: 17px; background: #3CE8FF18; border-radius: 4px;
                                border-width: 1px; border-color: #3CE8FF44;
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px;
                                    Text {
                                        vertical-alignment: center; text: "AI Companion"; color: #3CE8FF;
                                        font-family: Tokens.font-mono; font-size: 9px; font-weight: 600;
                                    }
                                }
                            }
                        }

                        // Subtle divider
                        Rectangle {
                            height: 1px;
                            background: #FFFFFF10;
                        }

                        // DeepSeek Web Style Reasoning Accordion
                        if m.thought != "" : VerticalLayout {
                            spacing: 8px;
                            alignment: start;

                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 24px;
                                    background: touch-think.has-hover ? #FFFFFF0C : transparent;
                                    border-radius: 6px;
                                    animate background { duration: 120ms; }
                                    touch-think := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-thought(idx); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 6px; padding-right: 8px; spacing: 6px;
                                        alignment: start;
                                        Icon {
                                            y: (parent.height - 13px) / 2;
                                            size: 13px;
                                            name: "atom";
                                            tint: #3CE8FF;
                                        }
                                        Text {
                                            vertical-alignment: center;
                                            text: m.think-label == "" ? "Berpikir" : m.think-label;
                                            color: #B4C3D6;
                                            font-family: Tokens.font-sans;
                                            font-size: 12px;
                                            font-weight: 500;
                                        }
                                        Icon {
                                            y: (parent.height - 9px) / 2;
                                            size: 9px;
                                            name: m.thought-open ? "chevron-up" : "chevron-down";
                                            tint: #64748B;
                                        }
                                    }
                                }
                            }

                            // Expanded Thought with Left Guide Line (DeepSeek Web)
                            if m.thought-open : HorizontalLayout {
                                spacing: 10px;
                                padding-left: 4px;
                                alignment: start;

                                // Left vertical guide bar
                                Rectangle {
                                    width: 2px;
                                    background: #334155;
                                    border-radius: 1px;
                                }

                                // Thought content and web steps
                                VerticalLayout {
                                    spacing: 8px;
                                    alignment: start;

                                    SelectableText {
                                        text: m.thought;
                                        color: #AEBDD1;
                                        font-family: Tokens.font-sans;
                                        font-size: 12px;
                                    }

                                    // Web Search Discovery Step inside thought
                                    if m.search-count > 0 : VerticalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        HorizontalLayout {
                                            spacing: 6px; alignment: start;
                                            Icon { y: (parent.height - 11px) / 2; size: 11px; name: "search"; tint: #38BDF8; }
                                            Text {
                                                vertical-alignment: center;
                                                text: "Ditemukan " + m.search-count + " halaman web";
                                                color: #CBD5E1;
                                                font-family: Tokens.font-sans;
                                                font-size: 11px;
                                                font-weight: 600;
                                            }
                                        }

                                        if m.sources.length > 0 : HorizontalLayout {
                                            spacing: 6px; alignment: start;
                                            Icon { y: (parent.height - 11px) / 2; size: 11px; name: "book"; tint: #A78BFA; }
                                            Text {
                                                vertical-alignment: center;
                                                text: "Membaca " + (m.sources.length < 5 ? m.sources.length : 5) + " halaman";
                                                color: #CBD5E1;
                                                font-family: Tokens.font-sans;
                                                font-size: 11px;
                                                font-weight: 600;
                                            }
                                        }

                                        // Top reading source cards inside thought
                                        for src[s_idx] in m.sources : Rectangle {
                                            height: s_idx < 5 ? 22px : 0px;
                                            visible: s_idx < 5;
                                            background: (s_idx < 5 && touch-src-item.has-hover) ? #1E293B88 : #0F172A40;
                                            border-radius: 4px;
                                            border-width: s_idx < 5 ? 1px : 0px;
                                            border-color: (s_idx < 5 && touch-src-item.has-hover) ? #38BDF844 : #1E293B60;
                                            touch-src-item := TouchArea {
                                                enabled: s_idx < 5;
                                                mouse-cursor: pointer;
                                                clicked => { root.open-url(src.url); }
                                            }
                                            if s_idx < 5 : HorizontalLayout {
                                                padding-left: 6px; padding-right: 6px; spacing: 6px;
                                                alignment: space-between;
                                                Text {
                                                    vertical-alignment: center;
                                                    text: src.title != "" ? src.title : src.url;
                                                    color: touch-src-item.has-hover ? #38BDF8 : #94A3B8;
                                                    font-family: Tokens.font-sans;
                                                    font-size: 10px;
                                                    overflow: elide;
                                                }
                                                Icon {
                                                    y: (parent.height - 9px) / 2;
                                                    size: 9px;
                                                    name: "external-link";
                                                    tint: touch-src-item.has-hover ? #38BDF8 : #64748B;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Typing dots indicator
                        if m.body == "" && m.thought == "" && root.busy : Rectangle {
                            height: 14px; width: 56px;
                            for d in [0, 1, 2] : Rectangle {
                                x: d * 14px; y: 2px;
                                width: 7px; height: 7px;
                                border-radius: 4px;
                                background: #93A2B8;
                                opacity: root.dot-phase == d ? 1.0 : 0.28;
                                animate opacity { duration: 240ms; }
                            }
                        }

                        // Answer blocks: structured typography, cards, lists, tables, code blocks
                        if m.body != "" && !m.select-mode && m.blocks.length > 0 : VerticalLayout {
                            spacing: 0px;
                            for blk[b-idx] in m.blocks : VerticalLayout {
                                padding-top: blk.gap-top * 1px;

                                // 1. Heading (with subtle left pill on H1-H3, optional color emoji & bottom rule on H1-H2)
                                if blk.kind == "heading" : VerticalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        property <length> bar-off: blk.level <= 3 ? 11px : 0px;
                                        property <length> emoji-w: blk.has-emoji-img ? 24px : 0px;
                                        height: max(hdr-flow.preferred-height, blk.has-emoji-img ? 21px : 0px);
                                        background: transparent;

                                        if blk.level <= 3 : Rectangle {
                                            x: 0;
                                            y: 2px;
                                            width: 3px;
                                            height: max(12px, parent.height - 4px);
                                            border-radius: 1.5px;
                                            background: blk.level == 1 ? #5CE1FF : (blk.level == 2 ? #3CE8FFCC : #3CE8FF88);
                                        }

                                        if blk.has-emoji-img : Image {
                                            x: parent.bar-off;
                                            y: 1px;
                                            width: 19px;
                                            height: 19px;
                                            image-fit: contain;
                                            source: blk.emoji-img;
                                        }

                                        hdr-flow := VerticalLayout {
                                            x: parent.bar-off + parent.emoji-w;
                                            y: 0;
                                            width: parent.width - parent.bar-off - parent.emoji-w;
                                            padding: 0px;
                                            spacing: 0px;

                                            if blk.plain-selectable : SelectableText {
                                                width: parent.width;
                                                text: blk.raw;
                                                color: blk.level <= 3 ? #FFFFFF : #DCE8F6;
                                                font-family: root.chat-font-family;
                                                font-size: (blk.level == 1 ? root.chat-font-px + 4.0
                                                    : (blk.level == 2 ? root.chat-font-px + 3.0
                                                    : (blk.level == 3 ? root.chat-font-px + 2.0
                                                    : root.chat-font-px + 1.0))) * 1px;
                                                font-weight: 700;
                                            }

                                            if !blk.plain-selectable : StyledText {
                                                width: parent.width;
                                                text: blk.styled;
                                                default-color: blk.level <= 3 ? #FFFFFF : #DCE8F6;
                                                default-font-family: root.chat-font-family;
                                                default-font-size: (blk.level == 1 ? root.chat-font-px + 4.0
                                                    : (blk.level == 2 ? root.chat-font-px + 3.0
                                                    : (blk.level == 3 ? root.chat-font-px + 2.0
                                                    : root.chat-font-px + 1.0))) * 1px;
                                                link-color: #5CE1FF;
                                                link-clicked(u) => { root.open-url(u); }
                                            }
                                        }
                                    }
                                    if blk.level <= 2 : Rectangle {
                                        height: 1px;
                                        background: blk.level == 1 ? #3CE8FF38 : #FFFFFF1C;
                                    }
                                }

                                // 2. Prose paragraph
                                if blk.kind == "prose" && blk.plain-selectable : SelectableText {
                                    width: parent.width;
                                    text: blk.raw;
                                    color: #F1F5FA;
                                    font-family: root.chat-font-family;
                                    font-size: root.chat-font-px * 1px;
                                }
                                if blk.kind == "prose" && !blk.plain-selectable : StyledText {
                                    width: parent.width;
                                    text: blk.styled;
                                    default-color: #F1F5FA;
                                    default-font-family: root.chat-font-family;
                                    default-font-size: root.chat-font-px * 1px;
                                    link-color: #5CE1FF;
                                    link-clicked(u) => { root.open-url(u); }
                                }

                                // 3. List item (true hanging indent, crisp colored status badges, optional color emoji & deterministic height)
                                if blk.kind == "list" : Rectangle {
                                    property <bool> is-status-marker: blk.marker == "todo" || blk.marker == "done" || blk.marker == "cross";
                                    property <length> indent-px: blk.indent * 14px;
                                    property <length> marker-w: self.is-status-marker
                                        ? 22px
                                        : ((blk.marker == "•" || blk.marker == "○" || blk.marker == "›")
                                            ? 16px
                                            : (blk.marker.character-count > 2 ? 26px : 20px));
                                    property <length> emoji-w: (!self.is-status-marker && blk.has-emoji-img) ? 21px : 0px;
                                    height: max(list-flow.preferred-height, (self.is-status-marker || blk.has-emoji-img) ? 19px : 0px);
                                    background: transparent;

                                    if self.is-status-marker : Image {
                                        x: parent.indent-px;
                                        y: max(1px, (root.chat-font-px * 1px - 16px) / 2 + 1px);
                                        width: 16px;
                                        height: 16px;
                                        image-fit: contain;
                                        source: blk.emoji-img;
                                    }

                                    if !self.is-status-marker : Text {
                                        x: parent.indent-px;
                                        y: 0;
                                        width: parent.marker-w - 4px;
                                        text: blk.marker;
                                        color: blk.indent > 0 ? #93C5FD : #5CE1FF;
                                        font-family: root.chat-font-family;
                                        font-size: root.chat-font-px * 1px;
                                        font-weight: 700;
                                        horizontal-alignment: left;
                                        vertical-alignment: top;
                                    }

                                    if !self.is-status-marker && blk.has-emoji-img : Image {
                                        x: parent.indent-px + parent.marker-w;
                                        y: 1px;
                                        width: 16px;
                                        height: 16px;
                                        image-fit: contain;
                                        source: blk.emoji-img;
                                    }

                                    list-flow := VerticalLayout {
                                        x: parent.indent-px + parent.marker-w + parent.emoji-w;
                                        y: 0;
                                        width: parent.width - parent.indent-px - parent.marker-w - parent.emoji-w;
                                        padding: 0px;
                                        spacing: 0px;

                                        if blk.plain-selectable : SelectableText {
                                            width: parent.width;
                                            text: blk.raw;
                                            color: #EEF4FA;
                                            font-family: root.chat-font-family;
                                            font-size: root.chat-font-px * 1px;
                                        }

                                        if !blk.plain-selectable : StyledText {
                                            width: parent.width;
                                            text: blk.styled;
                                            default-color: #EEF4FA;
                                            default-font-family: root.chat-font-family;
                                            default-font-size: root.chat-font-px * 1px;
                                            link-color: #5CE1FF;
                                            link-clicked(u) => { root.open-url(u); }
                                        }
                                    }
                                }

                                // 4. Blockquote / Tips card
                                if blk.kind == "quote" : Rectangle {
                                    background: #08122499;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #3CE8FF38;
                                    height: max(quote-flow.preferred-height, blk.has-emoji-img ? 34px : 0px);

                                    Rectangle {
                                        x: 10px;
                                        y: 9px;
                                        width: 3px;
                                        height: max(14px, parent.height - 18px);
                                        border-radius: 1.5px;
                                        background: #38BDF8;
                                    }

                                    if blk.has-emoji-img : Image {
                                        x: 20px;
                                        y: 9px;
                                        width: 17px;
                                        height: 17px;
                                        image-fit: contain;
                                        source: blk.emoji-img;
                                    }

                                    quote-flow := VerticalLayout {
                                        x: 0; y: 0;
                                        width: parent.width;
                                        padding-left: blk.has-emoji-img ? 43px : 21px;
                                        padding-right: 12px;
                                        padding-top: 9px;
                                        padding-bottom: 9px;
                                        if blk.plain-selectable : SelectableText {
                                            width: parent.width - (blk.has-emoji-img ? 55px : 33px);
                                            text: blk.raw;
                                            color: #DCE9F8;
                                            font-family: root.chat-font-family;
                                            font-size: max(12px, (root.chat-font-px - 1.0) * 1px);
                                        }
                                        if !blk.plain-selectable : StyledText {
                                            width: parent.width - (blk.has-emoji-img ? 55px : 33px);
                                            text: blk.styled;
                                            default-color: #DCE9F8;
                                            default-font-family: root.chat-font-family;
                                            default-font-size: max(12px, (root.chat-font-px - 1.0) * 1px);
                                            link-color: #5CE1FF;
                                            link-clicked(u) => { root.open-url(u); }
                                        }
                                    }
                                }

                                // Inline color emojis extracted from prose/headings/lists/quotes
                                if blk.kind != "emoji-row" && blk.emojis.length > 0 : HorizontalLayout {
                                    height: 22px;
                                    spacing: 4px;
                                    alignment: start;
                                    for eg in blk.emojis : Image {
                                        width: 18px;
                                        height: 18px;
                                        source: eg.img;
                                        image-fit: contain;
                                    }
                                }

                                // 5. Horizontal divider
                                if blk.kind == "divider" : Rectangle {
                                    height: 8px;
                                    background: transparent;
                                    Rectangle {
                                        x: 0; y: 3px;
                                        width: parent.width;
                                        height: 1px;
                                        background: #FFFFFF22;
                                    }
                                }

                                // 6. Code block card
                                if blk.kind == "code" : Rectangle {
                                    background: #060B15D9;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #3CE8FF42;
                                    clip: true;
                                    height: code-wrap.preferred-height + 2px;

                                    code-wrap := VerticalLayout {
                                        x: 1px; y: 1px;
                                        width: parent.width - 2px;
                                        spacing: 0px;

                                        // Header strip: language + copy button
                                        Rectangle {
                                            height: 28px;
                                            background: #0D182CE8;

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 6px;
                                                spacing: 6px;

                                                Rectangle {
                                                    y: 11px;
                                                    width: 6px; height: 6px;
                                                    border-radius: 3px;
                                                    background: #3CE8FF;
                                                }

                                                Text {
                                                    vertical-alignment: center;
                                                    text: blk.lang;
                                                    color: #93D5FF;
                                                    font-family: Tokens.font-mono-regular;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                }

                                                Rectangle { horizontal-stretch: 1; }

                                                code-copy-btn := Rectangle {
                                                    property <bool> copied-flash: false;
                                                    y: 4px;
                                                    width: 58px;
                                                    height: 20px;
                                                    border-radius: 5px;
                                                    background: code-copy-ta.has-hover ? #3CE8FF26 : #FFFFFF0E;
                                                    border-width: 1px;
                                                    border-color: code-copy-btn.copied-flash ? #3CE8FFAA
                                                        : (code-copy-ta.has-hover ? #3CE8FF66 : #FFFFFF1C);

                                                    HorizontalLayout {
                                                        padding-left: 7px;
                                                        padding-right: 7px;
                                                        spacing: 4px;
                                                        Icon {
                                                            y: 4px;
                                                            size: 10px;
                                                            name: code-copy-btn.copied-flash ? "check" : "copy";
                                                            tint: code-copy-btn.copied-flash ? #3CE8FF : #B8C7D9;
                                                        }
                                                        Text {
                                                            vertical-alignment: center;
                                                            text: code-copy-btn.copied-flash ? "Disalin" : "Salin";
                                                            color: code-copy-btn.copied-flash ? #3CE8FF : #D2DEE9;
                                                            font-family: Tokens.font-sans;
                                                            font-size: 10px;
                                                            font-weight: 600;
                                                        }
                                                    }

                                                    code-copy-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.copy-code(blk.raw);
                                                            code-copy-btn.copied-flash = true;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        Rectangle { height: 1px; background: #FFFFFF1A; }

                                        code-vp := Flickable {
                                            height: code-body.preferred-height;
                                            content-width: max(self.width, code-body.preferred-width);
                                            content-height: code-body.preferred-height;
                                            interactive: code-body.preferred-width > self.width;
                                            mouse-drag-pan-enabled: false;

                                            code-body := VerticalLayout {
                                                padding-left: 11px;
                                                padding-right: 11px;
                                                padding-top: 8px;
                                                padding-bottom: 9px;
                                                SelectableText {
                                                    text: blk.raw;
                                                    color: #E6EDF3;
                                                    font-family: Tokens.font-mono-regular;
                                                    font-size: max(11px, (root.chat-font-px - 2.0) * 1px);
                                                    font-weight: 400;
                                                    wrap: no-wrap;
                                                }
                                            }
                                        }

                                        if code-body.preferred-width > code-vp.width : Rectangle {
                                            height: 5px;
                                            background: #FFFFFF0A;
                                            Rectangle {
                                                y: 1px;
                                                x: (-code-vp.content-x / max(1px, code-vp.content-width)) * parent.width;
                                                width: max(20px, (code-vp.width / max(1px, code-vp.content-width)) * parent.width);
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: #3CE8FF66;
                                            }
                                        }
                                    }
                                }

                                // 7. Table card (bordered grid + header fill + zebra rows + align + h-scroll)
                                if blk.kind == "table" : Rectangle {
                                    background: #08101FD9;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #3CE8FF42;
                                    clip: true;
                                    height: tbl-wrap.preferred-height + 2px;

                                    tbl-wrap := VerticalLayout {
                                        x: 1px; y: 1px;
                                        width: parent.width - 2px;
                                        spacing: 0px;

                                        tbl-vp := Flickable {
                                            height: tbl-grid.preferred-height;
                                            content-width: max(self.width, blk.table-w * 1px);
                                            content-height: tbl-grid.preferred-height;
                                            interactive: (blk.table-w * 1px) > self.width;

                                            tbl-grid := VerticalLayout {
                                                width: blk.table-w * 1px;
                                                spacing: 0px;

                                                // Table Header Row
                                                Rectangle {
                                                    background: #12243FEB;
                                                    height: tbl-hdr.preferred-height;

                                                    tbl-hdr := HorizontalLayout {
                                                        spacing: 0px;
                                                        for cell[c-idx] in blk.headers : HorizontalLayout {
                                                            spacing: 0px;
                                                            if c-idx > 0 : Rectangle {
                                                                width: 1px;
                                                                background: #FFFFFF22;
                                                            }
                                                            VerticalLayout {
                                                                width: cell.width-px * 1px;
                                                                padding-left: 9px;
                                                                padding-right: 9px;
                                                                padding-top: 7px;
                                                                padding-bottom: 7px;
                                                                StyledText {
                                                                    width: cell.width-px * 1px - 18px;
                                                                    text: cell.styled;
                                                                    default-color: #FFFFFF;
                                                                    default-font-family: root.chat-font-family;
                                                                    default-font-size: max(12px, (root.chat-font-px - 1.0) * 1px);
                                                                    link-color: #5CE1FF;
                                                                    horizontal-alignment: cell.align == "center" ? TextHorizontalAlignment.center
                                                                        : (cell.align == "right" ? TextHorizontalAlignment.right : TextHorizontalAlignment.left);
                                                                    link-clicked(u) => { root.open-url(u); }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                Rectangle { height: 1px; background: #3CE8FF4D; }

                                                // Table Body Rows
                                                for row[r-idx] in blk.rows : VerticalLayout {
                                                    spacing: 0px;
                                                    if r-idx > 0 : Rectangle { height: 1px; background: #FFFFFF14; }
                                                    Rectangle {
                                                        background: Math.mod(r-idx, 2) == 1 ? #FFFFFF08 : transparent;
                                                        height: tbl-row.preferred-height;

                                                        tbl-row := HorizontalLayout {
                                                            spacing: 0px;
                                                            for cell[c-idx] in row.cells : HorizontalLayout {
                                                                spacing: 0px;
                                                                if c-idx > 0 : Rectangle {
                                                                    width: 1px;
                                                                    background: #FFFFFF18;
                                                                }
                                                                VerticalLayout {
                                                                    width: cell.width-px * 1px;
                                                                    padding-left: 9px;
                                                                    padding-right: 9px;
                                                                    padding-top: 6px;
                                                                    padding-bottom: 6px;
                                                                    StyledText {
                                                                        width: cell.width-px * 1px - 18px;
                                                                        text: cell.styled;
                                                                        default-color: #EDF3FA;
                                                                        default-font-family: root.chat-font-family;
                                                                        default-font-size: max(12px, (root.chat-font-px - 1.0) * 1px);
                                                                        link-color: #5CE1FF;
                                                                        horizontal-alignment: cell.align == "center" ? TextHorizontalAlignment.center
                                                                            : (cell.align == "right" ? TextHorizontalAlignment.right : TextHorizontalAlignment.left);
                                                                        link-clicked(u) => { root.open-url(u); }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        if (blk.table-w * 1px) > tbl-vp.width : Rectangle {
                                            height: 5px;
                                            background: #FFFFFF0A;
                                            Rectangle {
                                                y: 1px;
                                                x: (-tbl-vp.content-x / max(1px, tbl-vp.content-width)) * parent.width;
                                                width: max(20px, (tbl-vp.width / max(1px, tbl-vp.content-width)) * parent.width);
                                                height: 3px;
                                                border-radius: 1.5px;
                                                background: #3CE8FF66;
                                            }
                                        }
                                    }
                                }

                                // 8. Expressive color emoji reaction row
                                if blk.kind == "emoji-row" : HorizontalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    padding-top: 2px;
                                    padding-bottom: 2px;

                                    for em in blk.emojis : Image {
                                        width: 34px;
                                        height: 34px;
                                        image-fit: contain;
                                        source: em.img;
                                    }
                                }

                                // 9. Rich Image / SVG Diagram Card (click to zoom in Lightbox)
                                if blk.kind == "image" : Rectangle {
                                    background: #081122E0;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: #3CE8FF44;
                                    clip: true;
                                    height: img-card-col.preferred-height + 2px;

                                    img-card-col := VerticalLayout {
                                        x: 1px; y: 1px;
                                        width: parent.width - 2px;
                                        spacing: 0px;

                                        if blk.img-loading : HorizontalLayout {
                                            padding: 12px;
                                            spacing: 8px;
                                            Rectangle {
                                                y: 5px;
                                                width: 8px; height: 8px;
                                                border-radius: 4px;
                                                background: #3CE8FF;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: blk.img-caption != "" ? ("Memuat gambar: " + blk.img-caption + "...") : "Memuat gambar...";
                                                color: #93D5FF;
                                                font-family: root.chat-font-family;
                                                font-size: max(11px, (root.chat-font-px - 2.0) * 1px);
                                                wrap: word-wrap;
                                            }
                                        }

                                        if blk.img-failed : HorizontalLayout {
                                            padding: 10px;
                                            spacing: 8px;
                                            Icon {
                                                y: 2px;
                                                size: 14px;
                                                name: "image";
                                                tint: #F87171;
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 3px;
                                                Text {
                                                    text: blk.img-caption != "" ? (blk.img-caption + " — " + blk.raw) : blk.raw;
                                                    color: #FCA5A5;
                                                    font-family: root.chat-font-family;
                                                    font-size: 12px;
                                                    wrap: word-wrap;
                                                }
                                                if blk.img-url != "" : Rectangle {
                                                    height: 20px;
                                                    width: open-fail-lbl.preferred-width + 14px;
                                                    border-radius: 5px;
                                                    background: #3CE8FF1A;
                                                    border-width: 1px;
                                                    border-color: #3CE8FF55;
                                                    open-fail-lbl := Text {
                                                        x: 7px; y: 0;
                                                        height: parent.height;
                                                        vertical-alignment: center;
                                                        text: "Buka Tautan ↗";
                                                        color: #5CE1FF;
                                                        font-family: Tokens.font-sans;
                                                        font-size: 10px;
                                                        font-weight: 600;
                                                    }
                                                    TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.open-url(blk.img-url); }
                                                    }
                                                }
                                            }
                                        }

                                        if !blk.img-loading && !blk.img-failed : VerticalLayout {
                                            spacing: 0px;

                                            img-canvas := Rectangle {
                                                background: #0D192B;
                                                height: (blk.img-h <= 0 ? 110px : min(220px, max(44px, (blk.img-h * min(312px, max(96px, blk.img-w * 1px))) / max(1, blk.img-w)))) + 16px;

                                                Image {
                                                    x: 8px; y: 8px;
                                                    width: parent.width - 16px;
                                                    height: parent.height - 16px;
                                                    source: blk.img;
                                                    image-fit: contain;
                                                }

                                                img-zoom-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.lightbox-image = blk.img;
                                                        root.lightbox-caption = blk.img-caption;
                                                        root.lightbox-url = blk.img-url;
                                                        root.lightbox-raw = blk.raw;
                                                        root.lightbox-open = true;
                                                    }
                                                }

                                                // Subtle zoom pill on top-right
                                                Rectangle {
                                                    x: parent.width - 30px;
                                                    y: 6px;
                                                    width: 24px;
                                                    height: 20px;
                                                    border-radius: 5px;
                                                    background: img-zoom-ta.has-hover ? #132A48EE : #060B15BA;
                                                    border-width: 1px;
                                                    border-color: img-zoom-ta.has-hover ? #3CE8FFAA : #FFFFFF28;
                                                    Icon {
                                                        x: 6px; y: 4px;
                                                        size: 12px;
                                                        name: "search";
                                                        tint: img-zoom-ta.has-hover ? #3CE8FF : #CBD5E1;
                                                    }
                                                }
                                            }

                                            if blk.img-caption != "" || blk.lang == "svg" || blk.img-url != "" : Rectangle {
                                                height: 1px;
                                                background: #FFFFFF14;
                                            }

                                            if blk.img-caption != "" || blk.lang == "svg" || blk.img-url != "" : Rectangle {
                                                background: #0A1324EB;
                                                height: img-foot.preferred-height;

                                                img-foot := HorizontalLayout {
                                                    padding-left: 10px;
                                                    padding-right: 6px;
                                                    padding-top: 5px;
                                                    padding-bottom: 5px;
                                                    spacing: 6px;

                                                    Text {
                                                        horizontal-stretch: 1;
                                                        vertical-alignment: center;
                                                        text: blk.img-caption != "" ? blk.img-caption : (blk.lang == "svg" ? "Diagram SVG" : "Gambar");
                                                        color: #CBD5E1;
                                                        font-family: root.chat-font-family;
                                                        font-size: 11px;
                                                        wrap: word-wrap;
                                                    }

                                                    if blk.lang == "svg" : svg-copy-btn := Rectangle {
                                                        property <bool> copied-svg: false;
                                                        y: max(0px, (parent.height - 20px) / 2);
                                                        width: 68px;
                                                        height: 20px;
                                                        border-radius: 5px;
                                                        background: svg-copy-ta.has-hover ? #3CE8FF26 : #FFFFFF0E;
                                                        border-width: 1px;
                                                        border-color: svg-copy-btn.copied-svg ? #3CE8FFAA : (svg-copy-ta.has-hover ? #3CE8FF66 : #FFFFFF1C);
                                                        HorizontalLayout {
                                                            padding-left: 6px;
                                                            padding-right: 6px;
                                                            spacing: 4px;
                                                            Icon {
                                                                y: 4px;
                                                                size: 10px;
                                                                name: svg-copy-btn.copied-svg ? "check" : "copy";
                                                                tint: svg-copy-btn.copied-svg ? #3CE8FF : #B8C7D9;
                                                            }
                                                            Text {
                                                                vertical-alignment: center;
                                                                text: svg-copy-btn.copied-svg ? "Disalin" : "SVG";
                                                                color: svg-copy-btn.copied-svg ? #3CE8FF : #D2DEE9;
                                                                font-family: Tokens.font-sans;
                                                                font-size: 10px;
                                                                font-weight: 600;
                                                            }
                                                        }
                                                        svg-copy-ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.copy-code(blk.raw);
                                                                svg-copy-btn.copied-svg = true;
                                                            }
                                                        }
                                                    }

                                                    if blk.lang == "svg" || blk.img-url != "" : Rectangle {
                                                        y: max(0px, (parent.height - 20px) / 2);
                                                        width: 44px;
                                                        height: 20px;
                                                        border-radius: 5px;
                                                        background: img-open-ta.has-hover ? #3CE8FF26 : #FFFFFF0E;
                                                        border-width: 1px;
                                                        border-color: img-open-ta.has-hover ? #3CE8FF66 : #FFFFFF1C;
                                                        Text {
                                                            x: 0; y: 0;
                                                            width: parent.width;
                                                            height: parent.height;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                            text: "Buka";
                                                            color: #93D5FF;
                                                            font-family: Tokens.font-sans;
                                                            font-size: 10px;
                                                            font-weight: 600;
                                                        }
                                                        img-open-ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                if (blk.lang == "svg") {
                                                                    root.open-svg-external(blk.raw);
                                                                } else {
                                                                    root.open-url(blk.img-url);
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Fallback rich text if a message is plain/unblocked
                        if m.body != "" && !m.select-mode && m.blocks.length == 0 && m.user-selectable : SelectableText {
                            width: parent.width;
                            text: m.body;
                            color: #FFFFFF;
                            font-family: root.chat-font-family;
                            font-size: root.chat-font-px * 1px;
                        }
                        if m.body != "" && !m.select-mode && m.blocks.length == 0 && !m.user-selectable : StyledText {
                            text: m.styled;
                            default-color: #FFFFFF;
                            default-font-family: root.chat-font-family;
                            default-font-size: root.chat-font-px * 1px;
                            link-color: #5CE1FF;
                            link-clicked(u) => { root.open-url(u); }
                        }

                        // In-place free-select mode ("Salin Sebagian" active inside bubble)
                        if m.body != "" && m.select-mode : Rectangle {
                            background: #060C18C8;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: #3CE8FF55;
                            height: inline-sel-col.preferred-height;

                            inline-sel-col := VerticalLayout {
                                padding: 9px;
                                spacing: 7px;
                                alignment: start;

                                HorizontalLayout {
                                    height: 22px;
                                    alignment: space-between;
                                    Text {
                                        vertical-alignment: center;
                                        text: "Mode Pilih · Tarik teks lalu Ctrl+C";
                                        color: #7DD3FC;
                                        font-family: Tokens.font-sans;
                                        font-size: 11px;
                                        font-weight: 600;
                                    }
                                    Rectangle {
                                        width: 88px; height: 22px;
                                        border-radius: 6px;
                                        background: m.select-copied ? #0E334D : (sel-copy-ta.has-hover ? #1E293B : #151E2E);
                                        border-width: 1px;
                                        border-color: m.select-copied ? #38BDF8 : #3CE8FF55;
                                        Text {
                                            width: 100%; height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            text: m.select-copied ? "Disalin!" : "Salin Pilihan";
                                            color: m.select-copied ? #38BDF8 : #E2E8F0;
                                            font-family: Tokens.font-sans;
                                            font-size: 11px;
                                            font-weight: 600;
                                        }
                                        sel-copy-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down) {
                                                    root.prepare-partial-selection();
                                                }
                                            }
                                            clicked => {
                                                inline-sel-input.copy();
                                                root.commit-partial-selection(idx);
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: #3CE8FF26; }

                                inline-sel-input := SelectableText {
                                    width: parent.width - 18px;
                                    text: m.select-text;
                                    color: #F1F5FA;
                                    font-family: root.chat-font-family;
                                    font-size: root.chat-font-px * 1px;
                                }
                            }
                        }

                        // Web Search Sources Pill (DeepSeek Web Style -> opens modal "Hasil pencarian")
                        if m.search-count > 0 : HorizontalLayout {
                            alignment: start;
                            search-pill := Rectangle {
                                height: 28px;
                                background: touch-pill.has-hover ? #1F2633 : #161B24;
                                border-radius: 14px;
                                border-width: 1px;
                                border-color: touch-pill.has-hover ? #38BDF877 : #2C3444;
                                animate background, border-color { duration: 120ms; }
                                touch-pill := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-search-modal(idx); }
                                }
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 11px; spacing: 7px;
                                    alignment: start;
                                    // Up to 4 overlapping circular site favicon badges
                                    Rectangle {
                                        property <int> vis-badges: m.sources.length >= 4 ? 4 : (m.sources.length >= 1 ? m.sources.length : 3);
                                        width: (self.vis-badges - 1) * 11px + 18px;
                                        height: 18px;
                                        y: (parent.height - 18px) / 2;

                                        if m.sources.length > 0 : Rectangle {
                                            x: 0px; y: 0px; width: 18px; height: 18px; border-radius: 9px;
                                            background: m.sources[0].badge-color; border-width: 1.5px; border-color: #161B24;
                                            Text { width: 100%; height: 100%; text: m.sources[0].badge-text; color: #FFFFFF; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        if m.sources.length > 1 : Rectangle {
                                            x: 11px; y: 0px; width: 18px; height: 18px; border-radius: 9px;
                                            background: m.sources[1].badge-color; border-width: 1.5px; border-color: #161B24;
                                            Text { width: 100%; height: 100%; text: m.sources[1].badge-text; color: #FFFFFF; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        if m.sources.length > 2 : Rectangle {
                                            x: 22px; y: 0px; width: 18px; height: 18px; border-radius: 9px;
                                            background: m.sources[2].badge-color; border-width: 1.5px; border-color: #161B24;
                                            Text { width: 100%; height: 100%; text: m.sources[2].badge-text; color: #FFFFFF; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        if m.sources.length > 3 : Rectangle {
                                            x: 33px; y: 0px; width: 18px; height: 18px; border-radius: 9px;
                                            background: m.sources[3].badge-color; border-width: 1.5px; border-color: #161B24;
                                            Text { width: 100%; height: 100%; text: m.sources[3].badge-text; color: #FFFFFF; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        if m.sources.length == 0 : Rectangle {
                                            x: 0px; y: 0px; width: 18px; height: 18px; border-radius: 9px;
                                            background: #0284C7; border-width: 1.5px; border-color: #161B24;
                                            Text { width: 100%; height: 100%; text: "W"; color: #FFFFFF; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text {
                                        vertical-alignment: center;
                                        text: m.search-count + " halaman web";
                                        color: #E2E8F0;
                                        font-family: Tokens.font-sans;
                                        font-size: 12px;
                                        font-weight: 500;
                                    }
                                }
                            }
                        }

                        // Expanded Search Sources Drawer
                        if m.search-open && m.sources.length > 0 : Rectangle {
                            background: #090D18F0;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #1E293B;
                            clip: true;

                            VerticalLayout {
                                padding: 8px;
                                spacing: 5px;
                                alignment: start;

                                Text {
                                    text: "Sumber Pencarian (" + m.sources.length + ")";
                                    color: #64748B;
                                    font-family: Tokens.font-mono;
                                    font-size: 10px;
                                    font-weight: 600;
                                }

                                for src[s_idx] in m.sources : Rectangle {
                                    height: 38px;
                                    background: item-touch.has-hover ? #172236 : #0D1424;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: item-touch.has-hover ? #38BDF855 : #1E293B60;
                                    animate background, border-color { duration: 100ms; }
                                    item-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.open-url(src.url); }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px; padding-right: 8px; spacing: 8px;
                                        alignment: space-between;
                                        HorizontalLayout {
                                            spacing: 8px; alignment: start;
                                            Rectangle {
                                                y: (parent.height - 18px) / 2;
                                                width: 18px; height: 18px; border-radius: 9px;
                                                background: #1E293B;
                                                Text {
                                                    width: 100%; height: 100%;
                                                    horizontal-alignment: center; vertical-alignment: center;
                                                    text: "" + (s_idx + 1);
                                                    color: #94A3B8; font-size: 9px; font-weight: 600;
                                                }
                                            }
                                            VerticalLayout {
                                                alignment: center; spacing: 1px;
                                                Text {
                                                    text: src.title != "" ? src.title : src.url;
                                                    color: item-touch.has-hover ? #38BDF8 : #F1F5F9;
                                                    font-family: Tokens.font-sans;
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: src.url;
                                                    color: #64748B;
                                                    font-family: Tokens.font-mono;
                                                    font-size: 9px;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                        Icon {
                                            y: (parent.height - 11px) / 2;
                                            size: 11px;
                                            name: "external-link";
                                            tint: item-touch.has-hover ? #38BDF8 : #64748B;
                                        }
                                    }
                                }
                            }
                        }

                        // Failure retry row
                        if m.failed : Rectangle {
                            height: 20px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    vertical-alignment: center;
                                    text: "Gagal menghubungi model.";
                                    color: #FCA5A5; font-family: Tokens.font-sans; font-size: 12px;
                                }
                                Rectangle {
                                    width: 78px; height: 20px;
                                    background: #FF477E26; border-radius: 10px;
                                    Text {
                                        width: parent.width; height: parent.height; text: "Coba lagi"; color: #FFA9C3; font-family: Tokens.font-sans; font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.retry-request(idx); } }
                                }
                            }
                        }

                        // Action buttons: Salin -> Disalin, Salin Sebagian, Ulangi, Detail (ALWAYS below answer text!)
                        if m.body != "" : HorizontalLayout {
                            spacing: 5px;
                            alignment: end;
                            height: 24px;
                            HudAction {
                                icon-name: m.copied ? "check" : "copy";
                                label: m.copied ? "Disalin" : "Salin";
                                active: m.copied;
                                clicked => { root.copy-message(idx); }
                            }
                            HudAction {
                                icon-name: m.select-mode ? "check" : "edit";
                                label: m.select-mode ? "Tutup Pilih" : "Salin Sebagian";
                                active: m.select-mode;
                                clicked => { root.open-partial-copy(idx); }
                            }
                            HudAction {
                                icon-name: "refresh";
                                label: "Ulangi";
                                clicked => { root.retry-request(idx); }
                            }
                            HudAction {
                                icon-name: m.detail-open ? "chevron-up" : "info";
                                label: m.detail-open ? "Tutup" : "Detail";
                                active: m.detail-open;
                                clicked => { root.toggle-detail(idx); }
                            }
                        }

                        // Detail dropdown box (ALWAYS below buttons!)
                        if m.detail-open : Rectangle {
                            height: 26px;
                            background: #070A12E0;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #3CE8FF33;
                            HorizontalLayout {
                                padding-left: 9px; padding-right: 9px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 6px; alignment: start;
                                    Icon { y: (parent.height - 11px) / 2; size: 11px; name: "cpu"; tint: #3CE8FF; }
                                    Text { vertical-alignment: center; text: "Detail Respons:"; color: #94A3B8; font-family: Tokens.font-mono; font-size: 10px; }
                                }
                                Text { vertical-alignment: center; text: m.meta; color: #3CE8FF; font-family: Tokens.font-mono; font-size: 10px; font-weight: 600; }
                            }
                        }
                    }
                }
            }
        }

    }

    // Subtle custom scroll indicator on the right edge of chat viewport
    if chat-vp.content-height > chat-vp.height : Rectangle {
        x: parent.width - 5px;
        y: 45px;
        width: 3px;
        height: chat-vp.height - 80px - root.input-extra;
        background: transparent;

        Rectangle {
            x: 0;
            y: max(0px, min(parent.height - self.height, -chat-vp.content-y * (parent.height - self.height) / max(1px, chat-vp.content-height - chat-vp.height)));
            width: 3px;
            height: max(20px, parent.height * parent.height / max(1px, chat-vp.content-height));
            border-radius: 1.5px;
            background: #3CE8FF55;
        }
    }

    // =====================================================================
    //  FLOATING AUTO-SCROLL DOWN BUTTON
    // =====================================================================
    if chat-vp.content-height > chat-vp.height + 24px
        && (-chat-vp.content-y) < (chat-vp.content-height - chat-vp.height - 32px)
        && !root.pulldown-open
        && !root.search-modal-open
        && !root.lightbox-open : Rectangle {
        x: (parent.width - 118px) / 2;
        y: root.capsule-y - ((root.attachments.length > 0 || root.has-attachment) ? 106px : 36px);
        width: 118px;
        height: 28px;
        border-radius: 14px;
        background: scroll-btn-ta.has-hover ? #132844F5 : #0A1324EC;
        border-width: 1px;
        border-color: scroll-btn-ta.has-hover ? #5CE1FF : #3CE8FF88;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000090;

        scroll-btn-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.scroll-to-bottom(); }
        }

        HorizontalLayout {
            alignment: center;
            spacing: 5px;
            Icon {
                y: (parent.height - 12px) / 2;
                size: 12px;
                name: "arrow-down";
                tint: #5CE1FF;
            }
            Text {
                vertical-alignment: center;
                text: "Ke bawah";
                color: #E2F1FF;
                font-family: Tokens.font-sans;
                font-size: 11px;
                font-weight: 600;
            }
        }
    }

    // =====================================================================
    //  BOTTOM BAR BACKDROP  (sits behind attachment strip & floating composer)
    // =====================================================================
    // Soft glass gradient backdrop behind the floating bottom bar
    Rectangle {
        x: 0;
        y: parent.height - 96px - root.input-extra - ((root.attachments.length > 0 || root.has-attachment) ? 66px : 0px);
        width: parent.width;
        height: parent.height - self.y;
        background: @linear-gradient(180deg, transparent 0%, #070A1238 40%, #070A1299 100%);
    }

    // =====================================================================
    //  ATTACHMENT PREVIEW  (.hud-attachment-preview-area + multi-card strip)
    // =====================================================================
    if (root.attachments.length > 0 || root.has-attachment) && !root.pulldown-open : Flickable {
        x: 10px;
        y: root.capsule-y - 70px;
        width: parent.width - 84px;
        height: 70px;
        interactive: true;
        content-width: max(self.width, root.attachments.length * 68px + 8px);
        content-height: 70px;

        for att[a-idx] in root.attachments : Rectangle {
            x: 2px + a-idx * 68px;
            y: 6px;
            width: 60px; height: 60px;

            Rectangle {
                x: 0; y: 0;
                width: 60px; height: 60px;
                background: #070A12B8;
                border-width: 1.5px;
                border-color: #3CE8FF8C;
                border-radius: 12px;
                clip: true;

                touch-prev := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-pending-attachment-at(a-idx); }
                }

                if att.is-image : Image {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                    source: att.thumb;
                    image-fit: cover;
                }
                if touch-prev.has-hover : Rectangle {
                    x: 0; y: 0;
                    width: parent.width; height: parent.height;
                    background: #00000060;
                    Icon {
                        x: (parent.width - 18px) / 2;
                        y: (parent.height - 18px) / 2;
                        size: 18px;
                        name: "zoom";
                        tint: #FFFFFF;
                    }
                }
                if !att.is-image : Text {
                    x: 0; y: 17px;
                    width: parent.width;
                    height: 18px;
                    text: att.ext;
                    color: Tokens.halo-cyan;
                    font-family: Tokens.font-mono;
                    font-size: 13px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                if !att.is-image : Text {
                    x: 0; y: 36px;
                    width: parent.width;
                    height: 10px;
                    text: "FILE";
                    color: Tokens.text-dim;
                    font-family: Tokens.font-mono;
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 1px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                x: 0; y: 0;
                width: 60px; height: 60px;
                background: transparent;
                border-width: 1.5px;
                border-color: #3CE8FF8C;
                border-radius: 12px;
            }

            // .attachment-delete-btn: 20x20, top:-5 right:-5, over the card.
            delete-btn := Rectangle {
                x: 45px; y: -5px;
                width: 20px; height: 20px;
                background: #070A12E6;
                border-width: 1.5px;
                border-color: Tokens.overdrive-red;
                border-radius: 10px;

                delete-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.remove-attachment-at(a-idx); }
                }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    size: 10px;
                    name: "close";
                    tint: delete-touch.has-hover ? #FFFFFF : Tokens.overdrive-red;
                }
                states [
                    hovered when delete-touch.has-hover : {
                        background: Tokens.overdrive-red;
                        border-color: Tokens.overdrive-red;
                    }
                ]
            }
        }
    }

    // =====================================================================
    //  BOTTOM BAR  (.hud-bottom-bar)  Clean input bar + outside pink send button
    // =====================================================================

    // Dark rounded-rectangle composer container
    Rectangle {
        x: 12px; y: root.capsule-y;
        width: parent.width - 74px; height: root.capsule-h;
        border-radius: 12px;
        background: #151821F2;
        border-width: 1px;
        border-color: input.has-focus ? #3CE8FF66 : #2A2F3D;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000070;
        drop-shadow-offset-y: 3px;
    }

    // Click anywhere inside the input bar focuses the TextInput
    focus-touch := TouchArea {
        x: 12px;
        y: root.capsule-y;
        width: parent.width - 74px;
        height: root.capsule-h;
        clicked => { input.focus(); }
    }

    // Text editor: grows with wrapped content (via input-extra), scrolls cleanly beyond max height.
    input-scroll := ScrollView {
        x: 54px;
        y: root.capsule-y + 12.5px;
        width: parent.width - 156px;
        height: 19px + root.input-extra;
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: max(self.visible-height, input.preferred-height);

        input := TextInput {
            width: input-scroll.visible-width;
            text <=> root.input-text;
            color: #F8FAFC;
            font-family: Tokens.font-sans;
            font-size: 13px;
            vertical-alignment: top;
            wrap: word-wrap;
            single-line: false;
            page-height: input-scroll.visible-height;
            accepted => {
                if (!root.busy && root.enter-sends && (self.text != "" || root.attachments.length > 0)) {
                    root.send-request(self.text);
                }
            }
            key-pressed(event) => {
                if (event.modifiers.control && (event.text == "v" || event.text == "V")) {
                    root.paste-clipboard();
                    return reject;
                }
                if (event.text == Key.Return || event.text == "\n" || event.text == "\u{000d}") {
                    if (root.enter-sends && !event.modifiers.shift) {
                        if (!root.busy && (root.input-text != "" || root.attachments.length > 0)) {
                            root.send-request(root.input-text);
                        }
                        return accept;
                    }
                    return reject;
                }
                reject
            }
            cursor-position-changed(cpos) => {
                // Keep the caret in view while typing beyond the max height.
                if (cpos.y + input-scroll.content-y < 0px) {
                    input-scroll.content-y = min(
                        0px,
                        max(input-scroll.visible-height - self.height, -cpos.y),
                    );
                } else if (cpos.y + input-scroll.content-y > input-scroll.visible-height - 20px) {
                    input-scroll.content-y = min(
                        0px,
                        max(input-scroll.visible-height - self.height, input-scroll.visible-height - cpos.y - 20px),
                    );
                }
            }
        }
    }

    // Crisp placeholder text inside the input bar
    Text {
        x: 54px;
        y: root.capsule-y;
        width: parent.width - 156px;
        height: 44px;
        vertical-alignment: center;
        text: root.auto-capture ? "Tulis pesan (auto-capture)..." : "Tulis pesan...";
        color: #7E8798;
        font-family: Tokens.font-sans;
        font-size: 13px;
        overflow: elide;
        visible: root.input-text == "";
    }

    // Left attach (+) icon inside the input bar
    Rectangle {
        x: 20px;
        y: root.capsule-y + root.capsule-h - 36px;
        width: 28px; height: 28px;
        border-radius: 7px;
        background: attach-touch.has-hover ? #FFFFFF14 : transparent;

        attach-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.attach-requested(); }
        }
        Rectangle {
            x: 7px; y: 13.25px;
            width: 14px; height: 1.5px;
            border-radius: 1px;
            background: attach-touch.has-hover ? #F8FAFC : #94A3B8;
        }
        Rectangle {
            x: 13.25px; y: 7px;
            width: 1.5px; height: 14px;
            border-radius: 1px;
            background: attach-touch.has-hover ? #F8FAFC : #94A3B8;
        }
    }

    // Thin custom scrollbar for the composer (left of the camera button)
    Rectangle {
        x: parent.width - 101px;
        y: root.capsule-y + 10px;
        width: 2px;
        height: root.capsule-h - 20px;
        border-radius: 1px;
        background: #FFFFFF1F;
        visible: input-scroll.content-height > input-scroll.visible-height + 0.5px;

        Rectangle {
            width: parent.width;
            height: max(10px, parent.height * input-scroll.visible-height / input-scroll.content-height);
            y: (parent.height - self.height) * (-input-scroll.content-y)
                / max(1px, input-scroll.content-height - input-scroll.visible-height);
            border-radius: 1px;
            background: #E2E8F08C;
        }
    }

    // Right screenshot camera icon inside the input bar (plus attachment count badge)
    Rectangle {
        x: parent.width - 96px;
        y: root.capsule-y + root.capsule-h - 36px;
        width: 28px; height: 28px;
        border-radius: 7px;
        background: cam-touch.has-hover ? #FFFFFF14 : transparent;

        cam-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.capture-screen(); }
        }
        Icon {
            x: 6px; y: 6px;
            size: 16px;
            name: "camera";
            tint: cam-touch.has-hover ? #F8FAFC : #94A3B8;
        }
        if root.attachments.length > 0 : Rectangle {
            x: 16px; y: -1px;
            width: 15px; height: 15px;
            border-radius: 7.5px;
            background: Tokens.halo-cyan;
            border-width: 1px;
            border-color: #151821;
            Text {
                width: parent.width; height: parent.height;
                text: root.attachments.length;
                color: #070A12;
                font-family: Tokens.font-mono;
                font-size: 9px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // Outside-right pink rounded-square Send button (->)
    Rectangle {
        property <bool> can-send: (root.input-text != "" || root.attachments.length > 0) && !root.busy;
        x: parent.width - 54px;
        y: root.capsule-y + root.capsule-h - 44px;
        width: 42px; height: 44px;
        border-radius: 11px;
        background: self.can-send
            ? (send-touch.has-hover ? #FF99B3 : #FF85A2)
            : #FF85A24D;

        Icon {
            x: (parent.width - 16px) / 2;
            y: (parent.height - 16px) / 2;
            size: 16px;
            name: "arrow-right";
            tint: parent.can-send ? #1F1218 : #1F121880;
        }

        send-touch := TouchArea {
            mouse-cursor: parent.can-send ? pointer : default;
            clicked => {
                if (parent.can-send) {
                    root.send-request(root.input-text);
                }
            }
        }
    }

    // =====================================================================
    //  PULL-DOWN PANEL  (.hud-pulldown-panel)
    //  Web: x1 y45 378x464, padding 12 14 14, gap 12. The backdrop blur,
    //  intro ghost and CSS shadows are baked (software renderer cannot blur
    //  the backdrop or draw box-shadows).
    // =====================================================================

    // The baked 515px shadow PNG is gone: over the DWM backdrop it rendered as
    // a hard black band below the panel. The panel fill itself carries the
    // elevation now.
    // Click outside dropdown to dismiss
    if root.pulldown-open : TouchArea {
        x: 0; y: 44px;
        width: parent.width; height: parent.height - 44px;
        clicked => { root.toggle-pulldown(); }
    }

    if root.pulldown-open : Rectangle {
        x: 1px; y: 44px;
        width: parent.width - 2px;
        height: min(540px, min(parent.height - 50px, pulldown-layout.preferred-height));
        background: #0A0F1C;
        border-bottom-left-radius: 14px;
        border-bottom-right-radius: 14px;
        border-width: 1px;
        border-color: #3CE8FF59;
        clip: true;

        pulldown-scroll := Flickable {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            content-width: parent.width;
            content-height: pulldown-layout.preferred-height;

            pulldown-layout := VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 14px;
                padding-bottom: 16px;
                spacing: 12px;
                alignment: start;

                // ---- MODEL AI ----
                VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    Text {
                        text: "MODEL AI";
                        color: Tokens.halo-cyan;
                        font-family: Tokens.font-display;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                    }
                    HorizontalLayout {
                        height: 32px;
                        spacing: 8px;
                        for mstr[mid] in root.models : Rectangle {
                            height: 32px;
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            background: root.selected-model == mstr ? #3CE8FF26 : #070A1280;
                            border-width: 1px;
                            border-color: root.selected-model == mstr ? Tokens.halo-cyan : #FFFFFF1A;
                            Text {
                                width: parent.width - 12px;
                                height: parent.height;
                                x: 6px;
                                text: mstr;
                                color: root.selected-model == mstr ? #FFFFFF : Tokens.text-muted;
                                font-family: Tokens.font-display;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => { root.model-selected(mstr); }
                            }
                        }
                    }
                }

                // ---- SESI / TOPIK ----
                VerticalLayout {
                    spacing: 6px;
                    alignment: start;
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "SESI / TOPIK";
                            color: Tokens.halo-cyan;
                            font-family: Tokens.font-display;
                            font-size: 10px;
                            font-weight: 700;
                            letter-spacing: 0.5px;
                        }
                        Rectangle {
                            width: 80px; height: 18px;
                            Text {
                                width: parent.width; height: parent.height;
                                text: "+ Sesi Baru";
                                color: Tokens.aemeath-pink;
                                font-family: Tokens.font-display;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.new-session(); }
                            }
                        }
                    }

                    // Dynamically listed topics - fully scrollable with no truncation
                    for tstr[idx] in root.topics : Rectangle {
                        height: 30px;
                        background: root.current-topic == tstr ? #3CE8FF26 : #070A1280;
                        border-width: 1px;
                        border-color: root.current-topic == tstr ? Tokens.halo-cyan : #FFFFFF14;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                                text: tstr;
                                color: Tokens.text-main;
                                font-family: Tokens.font-sans;
                                font-size: 12px;
                                font-weight: 500;
                            }
                            if root.current-topic == tstr : Rectangle {
                                width: 38px; height: 16px;
                                y: (parent.height - 16px) / 2;
                                background: #FFD16626;
                                border-width: 1px;
                                border-color: #FFD1664D;
                                border-radius: 4px;
                                Text {
                                    width: parent.width; height: parent.height;
                                    text: "Aktif";
                                    color: Tokens.polestar-gold;
                                    font-family: Tokens.font-mono;
                                    font-size: 9px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        TouchArea {
                            clicked => { root.topic-selected(tstr); }
                        }
                    }
                }

                // ---- TOGGLES / PENGATURAN CEPAT ----
                for swv[idx] in [ 0, 1, 2, 3 ] : Rectangle {
                    height: 50px;
                    background: #070A1273;
                    border-width: 1px;
                    border-color: #3CE8FF26;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;

                            Text {
                                text: idx == 0 ? "Auto-Capture Layar"
                                    : idx == 1 ? "Sertakan Jendela App"
                                    : idx == 2 ? "Target Window (Game/App)"
                                    : "Temp Chat";
                                color: #F4F7FB;
                                font-family: Tokens.font-sans;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            Text {
                                overflow: elide;
                                text: idx == 0 ? "Jepret otomatis saat kirim pesan"
                                    : idx == 1 ? "Ikutkan Mini Assistant saat dijepret"
                                    : idx == 2 ? "Jepret hanya jendela aktif, bukan desktop"
                                    : "Percakapan sementara tanpa riwayat";
                                color: #CBD5E1;
                                font-family: Tokens.font-sans;
                                font-size: 11px;
                            }
                        }

                        Image {
                            width: 66px; height: 50px;
                            source: idx == 0
                                ? (root.auto-capture
                                    ? @image-url("../assets/hud/switch_on.png")
                                    : @image-url("../assets/hud/switch_off.png"))
                                : idx == 1
                                    ? (root.capture-app
                                        ? @image-url("../assets/hud/switch_on.png")
                                        : @image-url("../assets/hud/switch_off.png"))
                                    : idx == 2
                                        ? (root.target-window-only
                                            ? @image-url("../assets/hud/switch_on.png")
                                            : @image-url("../assets/hud/switch_off.png"))
                                        : (root.temp-chat
                                            ? @image-url("../assets/hud/switch_on.png")
                                            : @image-url("../assets/hud/switch_off.png"));
                        }
                    }

                    TouchArea {
                        clicked => {
                            if (idx == 0) { root.auto-capture-toggled(); }
                            if (idx == 1) { root.capture-app-toggled(); }
                            if (idx == 2) { root.target-window-toggled(); }
                            if (idx == 3) { root.temp-chat-toggled(); }
                        }
                    }
                }

                // ---- FOOTER ----
                Rectangle {
                    height: 1px;
                    background: #3CE8FF26;
                }

                Rectangle {
                    height: 32px;
                    background: #3CE8FF0F;
                    border-width: 1px;
                    border-color: #3CE8FF40;
                    border-radius: 6px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Icon {
                            y: (parent.height - 14px) / 2;
                            size: 14px;
                            name: "settings";
                            tint: Tokens.halo-cyan;
                        }
                        Text {
                            vertical-alignment: center;
                            text: "Control Panel Penuh";
                            color: Tokens.halo-cyan;
                            font-family: Tokens.font-sans;
                            font-size: 12px;
                            font-weight: 600;
                        }
                    }
                    TouchArea {
                        clicked => { root.open-control-panel(); }
                    }
                }
            }
        }
    }

    // =====================================================================
    //  IN-HUD WEB SEARCH SOURCES MODAL ("Hasil pencarian")
    // =====================================================================
    if root.search-modal-open : Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 15px;
        background: #060911F0;
        clip: true;

        TouchArea {
            clicked => { root.search-modal-open = false; }
        }

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.search-modal-open = false;
                    return accept;
                }
                reject
            }
        }

        Rectangle {
            x: 12px; y: 20px;
            width: parent.width - 24px;
            height: parent.height - 40px;
            background: #14161D;
            border-radius: 14px;
            border-width: 1px;
            border-color: #2B303E;
            clip: true;

            TouchArea { /* absorb backdrop clicks inside card */ }

            VerticalLayout {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                padding: 14px;
                spacing: 12px;

                // Header: "Hasil pencarian" + X close button
                HorizontalLayout {
                    height: 28px;
                    alignment: space-between;
                    Text {
                        vertical-alignment: center;
                        text: root.search-modal-count > root.search-modal-sources.length
                            ? "Hasil pencarian (" + root.search-modal-count + ")"
                            : "Hasil pencarian";
                        color: #F8FAFC;
                        font-family: Tokens.font-display;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Rectangle {
                        width: 26px; height: 26px;
                        border-radius: 7px;
                        background: sm-close-ta.has-hover ? #FFFFFF1E : transparent;
                        Icon {
                            x: 6px; y: 6px;
                            size: 14px;
                            name: "close";
                            tint: #CBD5E1;
                        }
                        sm-close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.search-modal-open = false; }
                        }
                    }
                }

                // Scrollable list of search source items matching attached modal design
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                    clip: true;

                    sm-vp := Flickable {
                        x: 0; y: 0;
                        width: parent.width;
                        height: parent.height;
                        content-width: parent.width;
                        content-height: sm-col.preferred-height;

                        sm-col := VerticalLayout {
                            spacing: 14px;
                            padding-right: 4px;
                            alignment: start;

                            for src[s-idx] in root.search-modal-sources : Rectangle {
                                height: src-inner.preferred-height;
                                border-radius: 10px;
                                background: src-ta.has-hover ? #1E222D : transparent;
                                animate background { duration: 100ms; }

                                src-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-url(src.url); }
                                }

                                src-inner := VerticalLayout {
                                    padding: 6px;
                                    spacing: 5px;
                                    alignment: start;

                                    // Row 1: circular badge + site name | date ...... [N]
                                    HorizontalLayout {
                                        alignment: space-between;
                                        height: 18px;
                                        HorizontalLayout {
                                            spacing: 7px;
                                            alignment: start;
                                            Rectangle {
                                                y: 1px;
                                                width: 16px; height: 16px;
                                                border-radius: 8px;
                                                background: src.badge-color;
                                                Text {
                                                    width: 100%; height: 100%;
                                                    text: src.badge-text;
                                                    color: #FFFFFF;
                                                    font-size: 8px;
                                                    font-weight: 800;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            Text {
                                                vertical-alignment: center;
                                                text: src.site-name != "" ? src.site-name : src.url;
                                                color: #D1D5DB;
                                                font-family: Tokens.font-sans;
                                                font-size: 12px;
                                                font-weight: 500;
                                            }
                                            if src.date != "" : Text {
                                                vertical-alignment: center;
                                                text: "|  " + src.date;
                                                color: #6B7280;
                                                font-family: Tokens.font-sans;
                                                font-size: 11px;
                                            }
                                        }
                                        Rectangle {
                                            y: 1px;
                                            width: 18px; height: 16px;
                                            border-radius: 8px;
                                            background: #272A35;
                                            Text {
                                                width: 100%; height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                text: "" + (s-idx + 1);
                                                color: #9CA3AF;
                                                font-family: Tokens.font-mono;
                                                font-size: 9px;
                                                font-weight: 600;
                                            }
                                        }
                                    }

                                    // Row 2: bold headline
                                    Text {
                                        text: src.title != "" ? src.title : src.url;
                                        color: src-ta.has-hover ? #5CE1FF : #F8FAFC;
                                        font-family: Tokens.font-sans;
                                        font-size: 13px;
                                        font-weight: 700;
                                        wrap: word-wrap;
                                    }

                                    // Row 3: snippet preview
                                    if src.snippet != "" : Text {
                                        text: src.snippet;
                                        color: #9CA3AF;
                                        font-family: Tokens.font-sans;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // =====================================================================
    //  IN-HUD IMAGE & SVG LIGHTBOX OVERLAY
    // =====================================================================
    if root.lightbox-open : Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-radius: 15px;
        background: #04070EE8;
        clip: true;

        // Absorb pointer events behind overlay; clicking dark empty margin closes
        TouchArea {
            clicked => { root.lightbox-open = false; }
        }

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.lightbox-open = false;
                    return accept;
                }
                reject
            }
        }

        VerticalLayout {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            padding: 12px;
            spacing: 10px;

            // Top bar
            Rectangle {
                height: 36px;
                background: #0A1324EB;
                border-radius: 9px;
                border-width: 1px;
                border-color: #3CE8FF44;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 6px;

                    Text {
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                        overflow: elide;
                        text: root.lightbox-caption != "" ? root.lightbox-caption : (root.lightbox-raw != "" ? "Pratinjau Diagram SVG" : "Pratinjau Gambar");
                        color: #F1F5FA;
                        font-family: Tokens.font-sans;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    if root.lightbox-raw != "" : lb-copy-btn := Rectangle {
                        property <bool> copied: false;
                        y: 6px;
                        width: 78px;
                        height: 24px;
                        border-radius: 6px;
                        background: lb-copy-ta.has-hover ? #3CE8FF26 : #FFFFFF10;
                        border-width: 1px;
                        border-color: lb-copy-btn.copied ? #3CE8FFAA : #3CE8FF44;
                        Text {
                            x: 0; y: 0;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: lb-copy-btn.copied ? "Disalin!" : "Salin SVG";
                            color: #3CE8FF;
                            font-family: Tokens.font-sans;
                            font-size: 11px;
                            font-weight: 600;
                        }
                        lb-copy-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.copy-code(root.lightbox-raw);
                                lb-copy-btn.copied = true;
                            }
                        }
                    }

                    if root.lightbox-raw != "" || root.lightbox-url != "" : Rectangle {
                        y: 6px;
                        width: 58px;
                        height: 24px;
                        border-radius: 6px;
                        background: lb-open-ta.has-hover ? #3CE8FF26 : #FFFFFF10;
                        border-width: 1px;
                        border-color: #3CE8FF44;
                        Text {
                            x: 0; y: 0;
                            width: parent.width;
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            text: "Buka ↗";
                            color: #93D5FF;
                            font-family: Tokens.font-sans;
                            font-size: 11px;
                            font-weight: 600;
                        }
                        lb-open-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.lightbox-raw != "") {
                                    root.open-svg-external(root.lightbox-raw);
                                } else {
                                    root.open-url(root.lightbox-url);
                                }
                            }
                        }
                    }

                    Rectangle {
                        y: 6px;
                        width: 24px;
                        height: 24px;
                        border-radius: 6px;
                        background: lb-close-ta.has-hover ? #FF477E33 : #FFFFFF14;
                        border-width: 1px;
                        border-color: lb-close-ta.has-hover ? Tokens.overdrive-red : #FFFFFF28;
                        Icon {
                            x: 5px; y: 5px;
                            size: 13px;
                            name: "close";
                            tint: #FFFFFF;
                        }
                        lb-close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.lightbox-open = false; }
                        }
                    }
                }
            }

            // Zoomed canvas (clicks inside box don't accidentally close unless backdrop clicked)
            Rectangle {
                vertical-stretch: 1;
                background: #0D192BF2;
                border-radius: 12px;
                border-width: 1px;
                border-color: #3CE8FF38;
                TouchArea {
                    // Absorb clicks on frame so only outer backdrop/close closes
                }
                Image {
                    x: 10px; y: 10px;
                    width: parent.width - 20px;
                    height: parent.height - 20px;
                    source: root.lightbox-image;
                    image-fit: contain;
                }
            }
        }
    }

    // =====================================================================
    //  GLASS BORDER OVERLAY  (drawn last so it covers every child edge)
    // =====================================================================
    Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;
        border-width: 1px;
        border-color: #3CE8FF66;
        border-radius: 16px;
    }

    // =====================================================================
    //  RESIZE GRIPPER (Visual accent dots at bottom-right corner)
    //  Winit natively handles border resizing via resize-border-width: 8px.
    // =====================================================================
    Rectangle {
        x: parent.width - 16px;
        y: parent.height - 16px;
        width: 14px;
        height: 14px;

        // Subtle diagonal grip dots
        Rectangle {
            x: 9px; y: 9px;
            width: 3px; height: 3px;
            border-radius: 1.5px;
            background: #3CE8FF80;
        }
        Rectangle {
            x: 5px; y: 9px;
            width: 3px; height: 3px;
            border-radius: 1.5px;
            background: #3CE8FF50;
        }
        Rectangle {
            x: 9px; y: 5px;
            width: 3px; height: 3px;
            border-radius: 1.5px;
            background: #3CE8FF50;
        }
    }

    // =====================================================================
    // Toasts removed: the bubble itself shows progress (typing dots) and
    // failures (inline retry), so no floating status text is needed.

}
