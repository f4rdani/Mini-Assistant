# ---- server ----
# 127.0.0.1 = only this machine can reach it (recommended). 0.0.0.0 = LAN.
HOST=127.0.0.1
PORT=8787
# comma separated keys for OUR api. empty = no auth
API_KEYS=
# required for /admin/* when HOST is not loopback. also accepted as x-admin-key
ADMIN_KEY=
DEFAULT_MODEL=deepseek-chat

# ---- upstream ----
DS_BASE_URL=https://chat.deepseek.com
DS_COMPLETION_PATH=/api/v0/chat/completion
# turn off only if DeepSeek stops requiring the pow header
DS_POW=on
# true = reuse one chat session per account. false = fresh session per call.
DS_REUSE_SESSION=false
# delete the chat session after each request so the web UI history stays clean
DS_DELETE_SESSION=true

# ---- accounts ----
# quick single account (or use accounts.json / POST /admin/accounts)
DS_COOKIE=
DS_TOKEN=
DS_ACCOUNTS_FILE=accounts.json
